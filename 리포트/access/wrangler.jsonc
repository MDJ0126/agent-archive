{
  "name": "tracefolio-private",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "../.site", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "ACCESS", "class_name": "AccessStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AccessStore"]}]
}
